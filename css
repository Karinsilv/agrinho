/* Reset básico e box-sizing */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Corpo do site */
body {
    font-family: Arial, sans-serif;
    background-color: #f4fdf4; /* verde claro suave */
    color: #333;
    line-height: 1.6;
}

/* Cabeçalho */
header {
    background: linear-gradient(135deg, #2e8b57, #4caf50);
    color: white;
    text-align: center;
    padding: 50px 20px;
}

header h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

header p {
    font-size: 1.2rem;
}

/* Navegação */
nav {
    background-color: #1f5f3b;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

nav ul li {
    padding: 15px 20px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s;
}

nav ul li a:hover {
    color: #a5d6a7;
}

/* Seções */
section {
    padding: 40px 20px;
    max-width: 1000px;
    margin: auto;
}

h2 {
    color: #2e8b57;
    margin-bottom: 20px;
    font-size: 2rem;
}

/* Cards para fontes de energia */
.card {
    background-color: white;
    padding: 20px;
    margin: 15px 0;
    border-left: 5px solid #4caf50;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

/* Lista de benefícios */
ul li {
    margin-bottom: 10px;
}

/* Botões */
button {
    background-color: #4caf50;
    color: white;
    border: none;
    padding: 12px 20px;
    margin-top: 15px;
    cursor: pointer;
    border-radius: 5px;
    transition: background-color 0.3s;
}

button:hover {
    background-color: #388e3c;
}

/* Formulário de contato */
form {
    display: flex;
    flex-direction: column;
}

input,
textarea {
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-family: inherit;
}

textarea {
    resize: vertical;
}

/* Mensagem de JavaScript */
#mensagem {
    margin-top: 15px;
    font-weight: bold;
    color: #2e8b57;
}

/* Rodapé */
footer {
    background-color: #1f5f3b;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}

/* Responsividade */
@media (max-width: 768px) {
    nav ul {
        flex-direction: column;
    }

    header h1 {
        font-size: 2rem;
    }

    h2 {
        font-size: 1.5rem;
    }
}
